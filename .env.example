# Azure OpenAI (heavy drafting / obligations)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# Optional cheap Azure deployment for fast-path memo drafting.
# Must exist on the same Azure OpenAI resource as AZURE_OPENAI_DEPLOYMENT.
# If missing (DeploymentNotFound), RegPilot falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_SMALL_DEPLOYMENT=

# TypeSafe System One (Jev) — triage, guardrail, confidence
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Neon Postgres
DATABASE_URL=
